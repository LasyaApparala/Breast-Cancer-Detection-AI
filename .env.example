# BreastGuard AI Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=BreastGuard AI
APP_VERSION=2.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# JWT Keys - Generate these with: openssl genrsa -out private.pem 2048
# and: openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./backend/keys/private.pem
JWT_PUBLIC_KEY_PATH=./backend/keys/public.pem
JWT_PRIVATE_KEY=your_private_key_here
JWT_PUBLIC_KEY=your_public_key_here

# Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Settings
BCRYPT_ROUNDS=12

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=breastguard_ai
POSTGRES_USER=breastguard_user
POSTGRES_PASSWORD=secure_password_here
POSTGRES_SSL_MODE=prefer

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=breastguard_ai_docs

# =============================================================================
# REDIS SETTINGS
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# STORAGE SETTINGS
# =============================================================================
# AWS S3 (Production)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=breastguard-ai-storage

# MinIO (Development)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=breastguard-ai
MINIO_SECURE=false

# =============================================================================
# ML SERVICE SETTINGS
# =============================================================================
ML_SERVICE_HOST=localhost
ML_SERVICE_PORT=8001
ML_MODEL_PATH=./ai/models
ML_BATCH_SIZE=32
ML_MAX_WORKERS=4

# Model Versions
EFFICIENTNET_VERSION=efficientnet_b4_breast_v2.1.0.pth
XGBOOST_VERSION=xgboost_clinical_v2.1.0.json
BIOMEDBERT_VERSION=dmis-lab/biobert-base-cased-v1.1

# =============================================================================
# DOCUMENT PARSER SETTINGS
# =============================================================================
DOCUMENT_PARSER_HOST=localhost
DOCUMENT_PARSER_PORT=8002
TESSERACT_PATH=/usr/bin/tesseract
MAX_FILE_SIZE_MB=50
SUPPORTED_FORMATS=pdf,dicom,jpg,jpeg,png,tiff,docx,txt

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Sentry (Error Tracking)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development

# Prometheus Metrics
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Structured Logging
LOG_FORMAT=json
LOG_FILE_PATH=./backend/logs/application.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# =============================================================================
# EMAIL NOTIFICATIONS
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
EMAIL_FROM=noreply@breastguard.ai
EMAIL_FROM_NAME=BreastGuard AI

# =============================================================================
# SECURITY & COMPLIANCE
# =============================================================================
# HTTPS Settings
HTTPS_ENABLED=true
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# PHI Protection
PHI_DEIDENTIFICATION_ENABLED=true
AUDIT_LOGGING_ENABLED=true
DATA_RETENTION_DAYS=365

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Frontend Development
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MOCK_MODE=false

# Backend Development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Testing
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/test_breastguard
TEST_MONGODB_URL=mongodb://localhost:27017/test_breastguard_docs

# =============================================================================
# DOCKER & DEPLOYMENT
# =============================================================================
# Docker Compose
COMPOSE_PROJECT_NAME=breastguard-ai
COMPOSE_FILE=docker-compose.yml

# Kubernetes
K8S_NAMESPACE=breastguard-ai
K8S_CONFIG_PATH=./k8s

# Health Checks
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Connection Pools
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
REDIS_POOL_SIZE=10

# Async Settings
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# Cache Settings
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/Disable Features
FEATURE_EXPLAINABILITY=true
FEATURE_CLINICIAN_REVIEW=true
FEATURE_BULK_UPLOAD=true
FEATURE_API_DOCS=true
FEATURE_DEMO_MODE=false

# Model Features
FEATURE_SHAP_EXPLANATIONS=true
FEATURE_GRAD_CAM=true
FEATURE_UNCERTAINTY_QUANTIFICATION=true
FEATURE_ENSEMBLE_FUSION=true
