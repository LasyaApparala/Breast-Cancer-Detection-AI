# Database
POSTGRES_DB=classifier_db
POSTGRES_USER=classifier_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://classifier_user:change_me@localhost:5432/classifier_db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security / JWT
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# KMS
KMS_PROVIDER=vault
VAULT_ADDR=https://vault.internal:8200
VAULT_TOKEN=change_me

# ML Models
MODEL_PATH=/app/models/classifier_v1.pkl
IMAGING_MODEL_PATH=/app/models/efficientnet_b4.pt
CALIBRATION_TEMPERATURE=1.42

# Service URLs
API_URL=http://localhost:8000
ML_SERVICE_URL=http://localhost:8001
DOCUMENT_PARSER_URL=http://localhost:8002
ALLOWED_ORIGINS=http://localhost:3000
