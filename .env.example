# BreastGuard AI — Environment Configuration

# ========== DATABASE ==========
# PostgreSQL connection (use for production; Docker Compose provides this)
DATABASE_URL=sqlite:///./backend/data/breastguard_dev.db
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/breastguard_ai

# SQLite for local development (included, no setup needed)
# DATABASE_URL=sqlite:///./backend/data/breastguard_dev.db

# ========== MONGODB (Audit Logs & HIPAA Compliance) ==========
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=breastguard_ai_docs

# ========== REDIS (Cache & Message Queue) ==========
REDIS_URL=redis://localhost:6379

# ========== MICROSERVICES (Inter-service Communication) ==========
# Document Parser Service (processes medical documents, OCR, NLP)
DOCUMENT_PARSER_URL=http://document_parser:8002
# ML Service (ensemble classification, TNM staging, SHAP explainability)
ML_SERVICE_URL=http://ml_service:8001
# RAG Service (retrieves PubMed literature, vector embeddings)
RAG_SERVICE_URL=http://rag_service:8003

# ========== SECURITY & AUTHENTICATION ==========
# JWT token secret key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# KMS Provider for encryption (local or cloud)
# Options: "local", "aws-kms", "azure-keyvault", "gcp-kms"
KMS_PROVIDER=local
# KMS_KEY_ID=arn:aws:kms:us-east-1:xxx:key/xxx  # Use if KMS_PROVIDER != local

# ========== CORS (Frontend Access) ==========
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ========== LOGGING & MONITORING ==========
LOG_LEVEL=INFO
SENTRY_DSN=  # Optional: error tracking (leave blank to disable)
PROMETHEUS_ENABLED=true

# ========== AI/ML Configuration ==========
# Model version to use for classification
MODEL_VERSION=v2.1.0
# Confidence threshold for clinical alerts
CONFIDENCE_THRESHOLD=0.75
# Minimum data completeness % for classification
MIN_COMPLETENESS_PCT=60

# ========== APPLICATION ==========
APP_ENV=development  # development, staging, production
APP_NAME=BreastGuard AI
APP_VERSION=2.1.0
